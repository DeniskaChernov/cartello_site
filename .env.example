# Public frontend settings only. Never put secrets in VITE_*.
# VITE_SITE_URL=https://cartello.uz
# VITE_GOOGLE_SITE_VERIFICATION=
# VITE_OG_IMAGE_URL=https://cartello.uz/custom-og.jpg
#
# Production always uses /api/send-telegram; API URL variables are unnecessary.
# npm run dev proxies /api to the local Worker (npm run cf:dev).
# Optional DEV-only override (a different server must allow its own CORS):
# VITE_LEAD_API_URL=http://localhost:8787/api/send-telegram
# VITE_API_BASE_URL=http://localhost:8787
# VITE_LEAD_API_PATH=/api/send-telegram
#
# Local Worker secrets: copy .dev.vars.example to .dev.vars.
# Production secrets: Cloudflare Worker Settings, never Vite variables.
# DATABASE_URL is used only by the legacy server and one-time export.
