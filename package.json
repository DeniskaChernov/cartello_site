{
  "name": "cartello-site",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "build": "node ./node_modules/vite/bin/vite.js build",
    "dev": "node ./node_modules/vite/bin/vite.js",
    "preview": "node ./node_modules/vite/bin/vite.js preview --host 0.0.0.0",
    "start": "serve dist -s",
    "cf:typegen": "wrangler types",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tests/tsconfig.json",
    "test": "vitest run && node --test tests/export.test.mjs",
    "cf:dev": "npm run build && wrangler d1 migrations apply DB --local && wrangler dev --ip 127.0.0.1 --port 8787",
    "cf:deploy": "npm run build && npm run check:bundle && wrangler deploy",
    "cf:build": "npm run build && wrangler deploy --dry-run --outdir .cloudflare-build",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "leads:export": "node --env-file-if-exists=.env.migration scripts/lead-export.mjs",
    "leads:verify": "node scripts/verify-leads.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:browser": "playwright test",
    "test:http": "node tests/http-smoke.mjs"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.5",
    "@mui/material": "7.3.5",
    "@popperjs/core": "2.11.8",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-aspect-ratio": "1.1.2",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-collapsible": "1.1.3",
    "@radix-ui/react-context-menu": "2.2.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-hover-card": "1.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-menubar": "1.1.6",
    "@radix-ui/react-navigation-menu": "1.2.5",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slider": "1.2.3",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-toggle": "1.1.2",
    "@radix-ui/react-toggle-group": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "3.6.0",
    "embla-carousel-react": "8.6.0",
    "hono": "^4.13.9",
    "input-otp": "1.4.2",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "next-themes": "0.4.6",
    "react": "18.3.1",
    "react-day-picker": "8.10.1",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.55.0",
    "react-popper": "2.3.0",
    "react-resizable-panels": "2.1.7",
    "react-responsive-masonry": "2.7.1",
    "react-slick": "0.31.0",
    "recharts": "2.15.2",
    "serve": "^14.2.4",
    "slick-carousel": "^1.8.1",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "postgres": "^3.4.9",
    "tailwindcss": "4.1.12",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.138.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.3"
    }
  }
}
