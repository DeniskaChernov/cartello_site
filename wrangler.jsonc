{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cartello",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "routes": [
    { "pattern": "www.cartello.uz", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/health"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "cartello-leads",
    "database_id": "9c9749bf-ecca-4296-ab0b-a35df420844a",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [{
    "name": "LEAD_RATE_LIMITER",
    "namespace_id": "2409202601",
    "simple": { "limit": 20, "period": 60 }
  }],
  "observability": { "enabled": true }
}
